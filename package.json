{
  "name": "cashx-game-bot",
  "version": "2.0.0",
  "description": "Telegram bot backend for CashX Game on PulseChain",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev":   "node --watch index.js",
    "gen-key": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "gen-mnemonic": "node -e \"const {ethers}=require('ethers');console.log(ethers.Wallet.createRandom().mnemonic.phrase)\""
  },
  "dependencies": {
    "better-sqlite3":       "^9.4.3",
    "dotenv":               "^16.4.5",
    "ethers":               "^6.11.1",
    "node-telegram-bot-api":"^0.66.0"
  },
  "engines": {
    "node": ">=18"
  }
}
