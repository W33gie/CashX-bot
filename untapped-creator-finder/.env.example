# --- Required -------------------------------------------------------------
# PostgreSQL connection string (local Postgres, Neon, Supabase, Railway, ...)
DATABASE_URL="postgresql://ucf:ucf_dev@localhost:5432/ucf?schema=public"

# Random 32+ character secret used to sign sessions.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me"
# Public URL of the app (used for auth callbacks)
BETTER_AUTH_URL="http://localhost:3000"

# --- Data providers (Phase 2, all optional) -------------------------------
# YouTube Data API v3 key - free, 10,000 quota units/day.
# Google Cloud Console -> APIs & Services -> enable "YouTube Data API v3" -> Credentials -> API key
YOUTUBE_API_KEY=""

# --- AI analysis (Phase 4, optional) --------------------------------------
ANTHROPIC_API_KEY=""
